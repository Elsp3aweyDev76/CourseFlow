<file path="src/components/AdminDashboardClient.tsx">
'use client';

import React, { useState, useTransition } from 'react';
import {
    Shield,
    Users,
    BookOpen,
    GraduationCap,
    Trash2,
    Search,
    AlertCircle,
} from 'lucide-react';
import {
    updateUserRoleAction,
    deleteUserAction,
} from '@/app/actions/admin';

export type AdminUser = {
    id: string;
    name: string;
    email: string;
    role: 'STUDENT' | 'INSTRUCTOR' | 'ADMIN' | string;
    createdAt: string;
};

type Stats = {
    totalUsers: number;
    totalCourses: number;
    totalEnrollments: number;
};

const ROLE_LABELS: Record<string, string> = {
    STUDENT: 'طالب',
    INSTRUCTOR: 'محاضر',
    ADMIN: 'مسؤول',
    student: 'طالب',
    instructor: 'محاضر',
    admin: 'مسؤول',
};

const ROLE_BADGE: Record<string, string> = {
    ADMIN: 'bg-purple-100 text-purple-700',
    INSTRUCTOR: 'bg-indigo-100 text-indigo-700',
    STUDENT: 'bg-slate-200 text-slate-700',
    admin: 'bg-purple-100 text-purple-700',
    instructor: 'bg-indigo-100 text-indigo-700',
    student: 'bg-slate-200 text-slate-700',
};

function normalizeRole(role: string): 'STUDENT' | 'INSTRUCTOR' | 'ADMIN' {
    const r = role.toUpperCase();
    if (r === 'ADMIN') return 'ADMIN';
    if (r === 'INSTRUCTOR') return 'INSTRUCTOR';
    return 'STUDENT';
}

export default function AdminDashboardClient({
    initialUsers,
    stats,
}: {
    initialUsers: AdminUser[];
    stats: Stats;
}) {
    const [users, setUsers] = useState<AdminUser[]>(initialUsers);
    const [searchQuery, setSearchQuery] = useState('');
    const [loadingId, setLoadingId] = useState<string | null>(null);
    const [message, setMessage] = useState<{ type: 'success' | 'error'; text: string } | null>(null);
    const [isPending, startTransition] = useTransition();

    const showMessage = (type: 'success' | 'error', text: string) => {
        setMessage({ type, text });
        setTimeout(() => setMessage(null), 4000);
    };

    const handleDeleteUser = (userId: string, userName: string) => {
        const isConfirmed = window.confirm(
            `هل أنت متأكد من حذف المستخدم «${userName}» نهائياً؟ لا يمكن التراجع عن هذا الإجراء.`
        );
        if (!isConfirmed) return;

        setLoadingId(userId);
        startTransition(async () => {
            const res = await deleteUserAction(userId);
            setLoadingId(null);

            if (res?.error) {
                showMessage('error', res.error);
                return;
            }

            setUsers((prev) => prev.filter((u) => u.id !== userId));
            showMessage('success', 'تم حذف المستخدم بنجاح.');
        });
    };

    const handleRoleChange = (userId: string, newRole: string) => {
        const previousUsers = users;

        // تحديث فوري للواجهة
        setUsers((prev) =>
            prev.map((u) =>
                u.id === userId ? { ...u, role: normalizeRole(newRole) } : u
            )
        );

        startTransition(async () => {
            const res = await updateUserRoleAction(userId, newRole);

            if (res?.error) {
                // التراجع عند الفشل
                setUsers(previousUsers);
                showMessage('error', res.error);
                return;
            }

            showMessage('success', 'تم تحديث دور المستخدم بنجاح.');
        });
    };

    const filteredUsers = users.filter(
        (user) =>
            user.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
            user.email.toLowerCase().includes(searchQuery.toLowerCase())
    );

    return (
        <div className="min-h-screen bg-slate-50 py-12 px-6 md:px-12" dir="rtl">
            <main className="max-w-7xl mx-auto space-y-8">
                {/* رأس الصفحة */}
                <div className="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div className="flex items-center gap-4">
                        <div className="w-14 h-14 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold shadow-inner">
                            <Shield className="w-7 h-7" />
                        </div>
                        <div>
                            <h1 className="text-3xl font-black text-slate-900">لوحة تحكم المسؤول</h1>
                            <p className="text-slate-500 text-sm mt-1">
                                إدارة شاملة للمستخدمين، الصلاحيات، ومتابعة إحصائيات المنصة
                            </p>
                        </div>
                    </div>
                </div>

                {/* رسائل النجاح/الفشل */}
                {message && (
                    <div
                        className={`p-4 rounded-2xl text-sm font-bold border ${message.type === 'success'
                                ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                                : 'bg-rose-50 text-rose-700 border-rose-200'
                            }`}
                    >
                        {message.text}
                    </div>
                )}

                {/* بطاقات الإحصائيات */}
                <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div className="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-all">
                        <div className="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold">
                            <Users className="w-6 h-6" />
                        </div>
                        <div>
                            <p className="text-slate-500 text-xs font-bold">إجمالي المستخدمين</p>
                            <h3 className="text-2xl font-black text-slate-900">{stats.totalUsers}</h3>
                        </div>
                    </div>

                    <div className="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-all">
                        <div className="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold">
                            <BookOpen className="w-6 h-6" />
                        </div>
                        <div>
                            <p className="text-slate-500 text-xs font-bold">إجمالي الدورات</p>
                            <h3 className="text-2xl font-black text-slate-900">{stats.totalCourses}</h3>
                        </div>
                    </div>

                    <div className="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-all">
                        <div className="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
                            <GraduationCap className="w-6 h-6" />
                        </div>
                        <div>
                            <p className="text-slate-500 text-xs font-bold">إجمالي التسجيلات</p>
                            <h3 className="text-2xl font-black text-slate-900">{stats.totalEnrollments}</h3>
                        </div>
                    </div>
                </div>

                {/* قسم إدارة المستخدمين */}
                <div className="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm space-y-6">
                    <div className="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-4 border-b border-slate-100">
                        <div>
                            <h2 className="text-xl font-black text-slate-900">إدارة حسابات المستخدمين</h2>
                            <p className="text-xs text-slate-500 mt-1">
                                التحكم في أدوار الصلاحيات ({users.length} مستخدم)
                            </p>
                        </div>

                        <div className="relative w-full md:w-72">
                            <Search className="absolute right-3.5 top-3.5 w-4 h-4 text-slate-400" />
                            <input
                                type="text"
                                value={searchQuery}
                                onChange={(e) => setSearchQuery(e.target.value)}
                                placeholder="ابحث بالاسم أو البريد..."
                                className="w-full pr-10 pl-4 py-2.5 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-purple-600 text-xs bg-slate-50"
                            />
                        </div>
                    </div>

                    <div className="space-y-3">
                        {filteredUsers.length > 0 ? (
                            filteredUsers.map((user) => {
                                const roleKey = normalizeRole(user.role);
                                return (
                                    <div
                                        key={user.id}
                                        className="flex flex-col md:flex-row items-start md:items-center justify-between p-5 rounded-2xl bg-slate-50/70 border border-slate-100 hover:bg-slate-50 transition-all gap-4"
                                    >
                                        <div className="space-y-1">
                                            <div className="flex items-center gap-2 flex-wrap">
                                                <span className="font-bold text-slate-900 text-sm">{user.name}</span>
                                                <span
                                                    className={`px-2.5 py-0.5 rounded-lg text-[10px] font-bold ${ROLE_BADGE[roleKey] || ROLE_BADGE.STUDENT
                                                        }`}
                                                >
                                                    {ROLE_LABELS[roleKey] || roleKey}
                                                </span>
                                            </div>
                                            <p className="text-xs text-slate-500">{user.email}</p>
                                        </div>

                                        <div className="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end">
                                            <select
                                                value={roleKey}
                                                disabled={isPending || loadingId === user.id}
                                                onChange={(e) => handleRoleChange(user.id, e.target.value)}
                                                className="bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-purple-600 shadow-sm disabled:opacity-50"
                                            >
                                                <option value="STUDENT">طالب</option>
                                                <option value="INSTRUCTOR">محاضر</option>
                                                <option value="ADMIN">مسؤول</option>
                                            </select>

                                            <button
                                                type="button"
                                                onClick={() => handleDeleteUser(user.id, user.name)}
                                                disabled={loadingId === user.id || isPending}
                                                className="p-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 transition-all shadow-sm cursor-pointer disabled:opacity-50"
                                                title="حذف المستخدم"
                                            >
                                                <Trash2 className="w-4 h-4" />
                                            </button>
                                        </div>
                                    </div>
                                );
                            })
                        ) : (
                            <div className="text-center py-12 space-y-2">
                                <AlertCircle className="w-10 h-10 text-slate-300 mx-auto" />
                                <p className="text-sm font-bold text-slate-600">
                                    {searchQuery ? 'لا توجد نتائج مطابقة لبحثك' : 'لا يوجد مستخدمون بعد'}
                                </p>
                            </div>
                        )}
                    </div>
                </div>
            </main>
        </div>
    );
}
</file>

<file path="src/components/CoursesCatalogClient.tsx">
'use client';

import { useMemo, useState } from 'react';
import Link from 'next/link';
import {
    BookOpen,
    Search,
    GraduationCap,
    Users,
    PlayCircle,
} from 'lucide-react';

export type CatalogCourse = {
    id: string;
    title: string;
    description: string | null;
    category: string;
    level: string;
    price: number;
    image: string | null;
    instructorName: string;
    lessonsCount: number;
    studentsCount: number;
    firstLessonId: string | null;
};

type Props = {
    initialCourses: CatalogCourse[];
};

export default function CoursesCatalogClient({ initialCourses }: Props) {
    const [query, setQuery] = useState('');
    const [category, setCategory] = useState('الكل');
    const [level, setLevel] = useState('الكل');

    const categories = useMemo(() => {
        const set = new Set(initialCourses.map((c) => c.category).filter(Boolean));
        return ['الكل', ...Array.from(set)];
    }, [initialCourses]);

    const levels = useMemo(() => {
        const set = new Set(initialCourses.map((c) => c.level).filter(Boolean));
        return ['الكل', ...Array.from(set)];
    }, [initialCourses]);

    const filtered = useMemo(() => {
        const q = query.trim().toLowerCase();
        return initialCourses.filter((course) => {
            const matchCategory = category === 'الكل' || course.category === category;
            const matchLevel = level === 'الكل' || course.level === level;
            const matchQuery =
                !q ||
                course.title.toLowerCase().includes(q) ||
                (course.description || '').toLowerCase().includes(q) ||
                course.instructorName.toLowerCase().includes(q);
            return matchCategory && matchLevel && matchQuery;
        });
    }, [initialCourses, query, category, level]);

    return (
        <div className="space-y-8" dir="rtl">
            <div className="flex flex-col lg:flex-row gap-3">
                <div className="relative flex-1">
                    <Search className="w-4 h-4 text-slate-500 absolute right-4 top-3.5" />
                    <input
                        value={query}
                        onChange={(e) => setQuery(e.target.value)}
                        placeholder="ابحث عن دورة أو محاضر..."
                        className="w-full bg-slate-950 border border-slate-800 rounded-2xl pr-11 pl-4 py-3 text-sm text-white outline-none focus:border-indigo-500"
                    />
                </div>

                <select
                    value={category}
                    onChange={(e) => setCategory(e.target.value)}
                    className="bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-white outline-none focus:border-indigo-500"
                >
                    {categories.map((c) => (
                        <option key={c} value={c}>
                            {c === 'الكل' ? 'كل التصنيفات' : c}
                        </option>
                    ))}
                </select>

                <select
                    value={level}
                    onChange={(e) => setLevel(e.target.value)}
                    className="bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-white outline-none focus:border-indigo-500"
                >
                    {levels.map((l) => (
                        <option key={l} value={l}>
                            {l === 'الكل' ? 'كل المستويات' : l}
                        </option>
                    ))}
                </select>
            </div>

            <div className="flex items-center justify-between text-sm text-slate-400">
                <span>
                    {filtered.length} دورة
                    {query || category !== 'الكل' || level !== 'الكل' ? ' مطابقة' : ''}
                </span>
            </div>

            {filtered.length === 0 ? (
                <div className="bg-slate-950 border border-slate-800 rounded-3xl p-12 text-center space-y-3">
                    <BookOpen className="w-10 h-10 text-slate-600 mx-auto" />
                    <p className="font-bold text-slate-300">لا توجد دورات مطابقة</p>
                    <p className="text-sm text-slate-500">جرّب تغيير البحث أو الفلاتر</p>
                    <button
                        type="button"
                        onClick={() => {
                            setQuery('');
                            setCategory('الكل');
                            setLevel('الكل');
                        }}
                        className="text-indigo-400 font-bold text-sm hover:underline"
                    >
                        مسح الفلاتر
                    </button>
                </div>
            ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    {filtered.map((course) => (
                        <article
                            key={course.id}
                            className="bg-slate-950 border border-slate-800 rounded-3xl overflow-hidden flex flex-col hover:border-indigo-500/40 transition-all group"
                        >
                            <div className="aspect-[16/10] bg-gradient-to-br from-indigo-600 to-violet-800 relative overflow-hidden">
                                {course.image ? (
                                    // eslint-disable-next-line @next/next/no-img-element
                                    <img
                                        src={course.image}
                                        alt={course.title}
                                        className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    />
                                ) : (
                                    <div className="w-full h-full flex items-center justify-center">
                                        <GraduationCap className="w-14 h-14 text-white/80" />
                                    </div>
                                )}
                                <span className="absolute top-3 right-3 bg-black/50 backdrop-blur text-xs font-bold px-3 py-1 rounded-full">
                                    {course.price === 0 ? 'مجاني' : `${course.price} ر.س`}
                                </span>
                            </div>

                            <div className="p-5 flex flex-col flex-1 space-y-3">
                                <div className="flex flex-wrap gap-2 text-[11px] font-bold">
                                    <span className="bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 px-2.5 py-1 rounded-full">
                                        {course.category}
                                    </span>
                                    <span className="bg-slate-900 text-slate-300 px-2.5 py-1 rounded-full">
                                        {course.level}
                                    </span>
                                </div>

                                <h3 className="font-bold text-lg leading-snug line-clamp-2 text-white">
                                    {course.title}
                                </h3>

                                <p className="text-sm text-slate-400 line-clamp-2 leading-relaxed flex-1">
                                    {course.description || 'لا يوجد وصف مختصر لهذه الدورة.'}
                                </p>

                                <div className="flex items-center justify-between text-xs text-slate-500 pt-1">
                                    <span className="truncate max-w-[50%]">
                                        {course.instructorName}
                                    </span>
                                    <div className="flex items-center gap-3 shrink-0">
                                        <span className="flex items-center gap-1">
                                            <BookOpen className="w-3.5 h-3.5" />
                                            {course.lessonsCount}
                                        </span>
                                        <span className="flex items-center gap-1">
                                            <Users className="w-3.5 h-3.5" />
                                            {course.studentsCount}
                                        </span>
                                    </div>
                                </div>

                                <Link
                                    href={`/courses/${course.id}`}
                                    className="mt-2 w-full inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm py-3 rounded-2xl transition-all"
                                >
                                    <PlayCircle className="w-4 h-4" />
                                    عرض التفاصيل
                                </Link>
                            </div>
                        </article>
                    ))}
                </div>
            )}
        </div>
    );
}
</file>

<file path="src/components/CreateCourseForm.tsx">
'use client';

import { useState, useTransition } from 'react';
import { useRouter } from 'next/navigation';
import { BookOpen, DollarSign, FileText, Image as ImageIcon, Layers, PlusCircle, Upload, Link2, X } from 'lucide-react';
import { createCourseAction } from '@/app/actions/instructor';

export default function CreateCourseForm() {
    const router = useRouter();
    const [error, setError] = useState('');
    const [success, setSuccess] = useState('');
    const [isPending, startTransition] = useTransition();

    // حالة طريقة إدخال الصورة والمعاينة
    const [imageMode, setImageMode] = useState<'file' | 'url'>('file');
    const [previewUrl, setPreviewUrl] = useState<string | null>(null);
    const [fileName, setFileName] = useState<string>('');

    const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
        const file = e.target.files?.[0];
        if (file) {
            setFileName(file.name);
            const objectUrl = URL.createObjectURL(file);
            setPreviewUrl(objectUrl);
        } else {
            setFileName('');
            setPreviewUrl(null);
        }
    };

    const clearImage = () => {
        setPreviewUrl(null);
        setFileName('');
    };

    const handleSubmit = (e: React.FormEvent<HTMLFormElement>) => {
        e.preventDefault();
        setError('');
        setSuccess('');

        const form = e.currentTarget;
        const formData = new FormData(form);

        startTransition(async () => {
            const res = await createCourseAction(formData);

            if (res?.error) {
                setError(res.error);
            } else {
                setSuccess('تم إنشاء الدورة بنجاح!');
                form.reset();
                clearImage();
                router.refresh();
            }
        });
    };

    return (
        <div className="bg-slate-950 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl" dir="rtl">
            <div className="flex items-center gap-3 mb-6">
                <div className="w-10 h-10 bg-indigo-600/20 text-indigo-400 rounded-xl flex items-center justify-center">
                    <PlusCircle className="w-6 h-6" />
                </div>
                <div>
                    <h2 className="text-lg font-bold text-white">إضافة دورة تدريبية جديدة</h2>
                    <p className="text-xs text-slate-400">أدخل تفاصيل الدورة الأساسية لتظهر للطلاب على المنصة</p>
                </div>
            </div>

            {error && (
                <div className="mb-4 bg-rose-500/10 text-rose-400 border border-rose-500/20 text-xs font-bold p-3.5 rounded-2xl">
                    {error}
                </div>
            )}

            {success && (
                <div className="mb-4 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold p-3.5 rounded-2xl">
                    {success}
                </div>
            )}

            <form onSubmit={handleSubmit} className="space-y-5">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {/* عنوان الدورة */}
                    <div className="space-y-1.5">
                        <label className="text-xs font-bold text-slate-300">عنوان الدورة *</label>
                        <div className="relative">
                            <BookOpen className="w-4 h-4 text-slate-500 absolute right-3.5 top-3.5" />
                            <input
                                name="title"
                                type="text"
                                required
                                placeholder="مثال: احتراف Next.js من الصفر"
                                className="w-full pr-10 pl-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:border-indigo-600"
                            />
                        </div>
                    </div>

                    {/* السعر */}
                    <div className="space-y-1.5">
                        <label className="text-xs font-bold text-slate-300">السعر (بالدولار - اتركه 0 للمجاني)</label>
                        <div className="relative">
                            <DollarSign className="w-4 h-4 text-slate-500 absolute right-3.5 top-3.5" />
                            <input
                                name="price"
                                type="number"
                                step="0.01"
                                min="0"
                                defaultValue="0"
                                className="w-full pr-10 pl-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:border-indigo-600"
                            />
                        </div>
                    </div>

                    {/* التصنيف */}
                    <div className="space-y-1.5">
                        <label className="text-xs font-bold text-slate-300">التصنيف</label>
                        <div className="relative">
                            <Layers className="w-4 h-4 text-slate-500 absolute right-3.5 top-3.5" />
                            <select
                                name="category"
                                className="w-full pr-10 pl-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:border-indigo-600"
                            >
                                <option value="برمجة وتطوير">برمجة وتطوير</option>
                                <option value="تصميم وجرافيك">تصميم وجرافيك</option>
                                <option value="أعمال وتسويق">أعمال وتسويق</option>
                                <option value="ذكاء اصطناعي">ذكاء اصطناعي</option>
                            </select>
                        </div>
                    </div>

                    {/* المستوى */}
                    <div className="space-y-1.5">
                        <label className="text-xs font-bold text-slate-300">المستوى</label>
                        <select
                            name="level"
                            className="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:border-indigo-600"
                        >
                            <option value="مبتدئ">مبتدئ</option>
                            <option value="متوسط">متوسط</option>
                            <option value="متقدم">متقدم</option>
                        </select>
                    </div>
                </div>

                {/* صورة الغلاف (اختيار من الجهاز أو رابط) */}
                <div className="space-y-2">
                    <div className="flex items-center justify-between">
                        <label className="text-xs font-bold text-slate-300">صورة غلاف الدورة (اختياري)</label>
                        <div className="flex items-center gap-1 bg-slate-900 p-1 rounded-lg border border-slate-800">
                            <button
                                type="button"
                                onClick={() => {
                                    setImageMode('file');
                                    clearImage();
                                }}
                                className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold transition-all ${imageMode === 'file' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'
                                    }`}
                            >
                                <Upload className="w-3.5 h-3.5" />
                                <span>من الجهاز</span>
                            </button>
                            <button
                                type="button"
                                onClick={() => {
                                    setImageMode('url');
                                    clearImage();
                                }}
                                className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold transition-all ${imageMode === 'url' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'
                                    }`}
                            >
                                <Link2 className="w-3.5 h-3.5" />
                                <span>رابط خارجي</span>
                            </button>
                        </div>
                    </div>

                    {imageMode === 'file' ? (
                        <div className="space-y-3">
                            <label className="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-slate-800 hover:border-indigo-600 rounded-2xl bg-slate-900/50 cursor-pointer transition-all">
                                <div className="flex flex-col items-center justify-center pt-5 pb-6 text-center px-4">
                                    <Upload className="w-7 h-7 text-indigo-400 mb-2" />
                                    <p className="text-xs font-bold text-slate-300">
                                        {fileName ? fileName : 'اضغط هنا لاختيار صورة من جهازك (Browse)'}
                                    </p>
                                    <p className="text-[11px] text-slate-500 mt-1">PNG, JPG, WebP (بحد أقصى 5MB)</p>
                                </div>
                                <input
                                    name="imageFile"
                                    type="file"
                                    accept="image/*"
                                    onChange={handleFileChange}
                                    className="hidden"
                                />
                            </label>

                            {previewUrl && (
                                <div className="relative w-48 h-28 rounded-xl overflow-hidden border border-slate-700">
                                    <img src={previewUrl} alt="معاينة الغلاف" className="w-full h-full object-cover" />
                                    <button
                                        type="button"
                                        onClick={clearImage}
                                        className="absolute top-1.5 left-1.5 bg-slate-950/80 hover:bg-rose-600 text-white p-1 rounded-full transition-all"
                                        title="إزالة الصورة"
                                    >
                                        <X className="w-3.5 h-3.5" />
                                    </button>
                                </div>
                            )}
                        </div>
                    ) : (
                        <div className="relative">
                            <ImageIcon className="w-4 h-4 text-slate-500 absolute right-3.5 top-3.5" />
                            <input
                                name="imageUrl"
                                type="url"
                                placeholder="https://example.com/course-cover.jpg"
                                className="w-full pr-10 pl-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:border-indigo-600"
                            />
                        </div>
                    )}
                </div>

                {/* وصف الدورة */}
                <div className="space-y-1.5">
                    <label className="text-xs font-bold text-slate-300">وصف الدورة *</label>
                    <div className="relative">
                        <FileText className="w-4 h-4 text-slate-500 absolute right-3.5 top-3.5" />
                        <textarea
                            name="description"
                            rows={4}
                            required
                            placeholder="اكتب وصفاً واضحاً لما سيتعلمه الطالب في هذه الدورة..."
                            className="w-full pr-10 pl-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-sm focus:outline-none focus:border-indigo-600"
                        />
                    </div>
                </div>

                <button
                    type="submit"
                    disabled={isPending}
                    className="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-3 rounded-xl shadow-lg shadow-indigo-600/25 transition-all text-sm disabled:opacity-50"
                >
                    {isPending ? 'جاري حفظ الدورة...' : 'نشر الدورة الآن'}
                </button>
            </form>
        </div>
    );
}
</file>

<file path="src/components/CreateLessonForm.tsx">
'use client';

import { useRef, useState } from 'react';
import { useRouter } from 'next/navigation';
import { Film, Upload, X, Link2 } from 'lucide-react';
import { createLessonAction } from '@/app/actions/instructor';

type CourseOption = { id: string; title: string };

function formatSize(bytes: number) {
    if (bytes < 1024 * 1024) {
        return `${Math.max(1, Math.round(bytes / 1024))} ك.ب`;
    }
    return `${(bytes / (1024 * 1024)).toFixed(1)} م.ب`;
}

export default function CreateLessonForm({
    courses,
}: {
    courses: CourseOption[];
}) {
    const router = useRouter();
    const inputRef = useRef<HTMLInputElement>(null);
    const [error, setError] = useState('');
    const [success, setSuccess] = useState('');
    const [loading, setLoading] = useState(false);
    const [file, setFile] = useState<File | null>(null);
    const [dragOver, setDragOver] = useState(false);
    const [useLink, setUseLink] = useState(false);

    if (courses.length === 0) {
        return (
            <p className="text-sm text-slate-400 bg-slate-950 border border-slate-800 rounded-2xl p-6">
                أنشئ دورة أولاً ثم أضف لها دروساً بالفيديو.
            </p>
        );
    }

    function pickFile(next: File | null) {
        if (!next) return;
        if (!next.type.startsWith('video/')) {
            setError('اختر ملف فيديو MP4 أو WebM');
            return;
        }
        if (next.size > 100 * 1024 * 1024) {
            setError('حجم الفيديو يجب ألا يتجاوز 100 ميجابايت');
            return;
        }
        setError('');
        setFile(next);
        setUseLink(false);
    }

    function clearFile() {
        setFile(null);
        if (inputRef.current) inputRef.current.value = '';
    }

    async function handleSubmit(e: React.FormEvent<HTMLFormElement>) {
        e.preventDefault();
        setLoading(true);
        setError('');
        setSuccess('');

        const formData = new FormData(e.currentTarget);
        if (file) formData.set('videoFile', file);

        const res = await createLessonAction(formData);
        setLoading(false);

        if (res?.error) {
            setError(res.error);
            return;
        }

        setSuccess('تم حفظ الدرس بنجاح');
        e.currentTarget.reset();
        clearFile();
        router.refresh();
    }

    const field =
        'w-full bg-slate-900 border border-slate-800 rounded-2xl px-4 py-3 text-sm outline-none focus:border-indigo-500 text-white';

    return (
        <form
            onSubmit={handleSubmit}
            className="bg-slate-950 border border-slate-800 rounded-3xl p-6 space-y-5"
        >
            <div>
                <h2 className="text-lg font-bold text-white">إضافة درس بفيديو</h2>
                <p className="text-xs text-slate-500 mt-1">
                    ارفع فيديو، وحدد اختباراً اختيارياً يُفتح بعد مشاهدة الدرس.
                </p>
            </div>

            {error && (
                <p className="text-sm text-rose-300 bg-rose-500/10 border border-rose-500/20 rounded-2xl px-4 py-3">
                    {error}
                </p>
            )}
            {success && (
                <p className="text-sm text-emerald-300 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl px-4 py-3">
                    {success}
                </p>
            )}

            <label className="block space-y-1.5 text-sm">
                <span className="text-slate-300 font-medium">الدورة</span>
                <select name="courseId" required className={field}>
                    {courses.map((c) => (
                        <option key={c.id} value={c.id}>
                            {c.title}
                        </option>
                    ))}
                </select>
            </label>

            <label className="block space-y-1.5 text-sm">
                <span className="text-slate-300 font-medium">عنوان الدرس</span>
                <input
                    name="title"
                    required
                    className={field}
                    placeholder="مثال: مقدمة قواعد البيانات"
                />
            </label>

            <div className="grid grid-cols-2 gap-3">
                <label className="block space-y-1.5 text-sm">
                    <span className="text-slate-300 font-medium">الترتيب</span>
                    <input
                        name="order"
                        type="number"
                        min={1}
                        defaultValue={1}
                        className={field}
                    />
                </label>
                <label className="block space-y-1.5 text-sm">
                    <span className="text-slate-300 font-medium">المدة</span>
                    <input name="duration" defaultValue="10 دقائق" className={field} />
                </label>
            </div>

            <label className="block space-y-1.5 text-sm">
                <span className="text-slate-300 font-medium">ملاحظات / محتوى نصي (اختياري)</span>
                <textarea name="content" rows={3} className={`${field} resize-y`} />
            </label>

            <div className="flex gap-2">
                <button
                    type="button"
                    onClick={() => setUseLink(false)}
                    className={`flex-1 py-2.5 rounded-xl text-sm font-bold border ${!useLink
                            ? 'bg-indigo-600 border-indigo-500 text-white'
                            : 'border-slate-800 text-slate-400'
                        }`}
                >
                    رفع ملف
                </button>
                <button
                    type="button"
                    onClick={() => {
                        setUseLink(true);
                        clearFile();
                    }}
                    className={`flex-1 py-2.5 rounded-xl text-sm font-bold border ${useLink
                            ? 'bg-indigo-600 border-indigo-500 text-white'
                            : 'border-slate-800 text-slate-400'
                        }`}
                >
                    رابط فيديو
                </button>
            </div>

            {!useLink ? (
                <div>
                    <input
                        ref={inputRef}
                        name="videoFile"
                        type="file"
                        accept="video/mp4,video/webm"
                        className="hidden"
                        onChange={(e) => pickFile(e.target.files?.[0] ?? null)}
                    />
                    {!file ? (
                        <button
                            type="button"
                            onClick={() => inputRef.current?.click()}
                            onDragOver={(e) => {
                                e.preventDefault();
                                setDragOver(true);
                            }}
                            onDragLeave={() => setDragOver(false)}
                            onDrop={(e) => {
                                e.preventDefault();
                                setDragOver(false);
                                pickFile(e.dataTransfer.files?.[0] ?? null);
                            }}
                            className={`w-full rounded-2xl border border-dashed px-6 py-10 text-center transition ${dragOver
                                    ? 'border-indigo-400 bg-indigo-500/10'
                                    : 'border-slate-700 bg-slate-900/60 hover:border-slate-500'
                                }`}
                        >
                            <span className="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo-500/15 text-indigo-300">
                                <Upload className="w-6 h-6" />
                            </span>
                            <span className="block font-bold text-slate-100">
                                اسحب الفيديو هنا أو اضغط للاختيار
                            </span>
                            <span className="mt-1 block text-xs text-slate-500">
                                MP4 أو WebM · حتى 100 م.ب
                            </span>
                        </button>
                    ) : (
                        <div className="flex items-center gap-3 rounded-2xl border border-slate-800 bg-slate-900 px-4 py-3">
                            <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-500/15 text-indigo-300">
                                <Film className="w-5 h-5" />
                            </span>
                            <span className="min-w-0 flex-1 text-right">
                                <span className="block truncate text-sm font-bold text-white">
                                    {file.name}
                                </span>
                                <span className="block text-xs text-slate-500">
                                    {formatSize(file.size)} · جاهز للرفع
                                </span>
                            </span>
                            <button
                                type="button"
                                onClick={clearFile}
                                className="rounded-lg p-2 text-slate-400 hover:bg-slate-800 hover:text-white"
                                aria-label="إزالة الملف"
                            >
                                <X className="w-4 h-4" />
                            </button>
                        </div>
                    )}
                </div>
            ) : (
                <label className="block space-y-1.5 text-sm">
                    <span className="text-slate-300 font-medium flex items-center gap-2">
                        <Link2 className="w-4 h-4" /> رابط الفيديو
                    </span>
                    <input
                        name="videoUrl"
                        required={useLink}
                        placeholder="https://... أو /videos/lesson.mp4"
                        className={field}
                    />
                </label>
            )}

            <div className="rounded-2xl border border-slate-800 bg-slate-900/50 p-4 space-y-4">
                <div>
                    <h3 className="font-bold text-sm text-white">اختبار الدرس (اختياري)</h3>
                    <p className="text-xs text-slate-500 mt-1">
                        إن تركت السؤال فارغاً يُحفظ الدرس بدون اختبار.
                    </p>
                </div>

                <label className="block space-y-1.5 text-sm">
                    <span className="text-slate-300 font-medium">سؤال الاختبار</span>
                    <input
                        name="quizQuestion"
                        placeholder="مثال: ما الذي يميز قواعد البيانات العلائقية؟"
                        className={field}
                    />
                </label>

                <label className="block space-y-1.5 text-sm">
                    <span className="text-slate-300 font-medium">
                        الخيارات (كل خيار في سطر)
                    </span>
                    <textarea
                        name="quizOptions"
                        rows={4}
                        placeholder={
                            'تخزين البيانات في جداول مترابطة\nتخزين الصور فقط\nتشغيل الواجهات الأمامية'
                        }
                        className={`${field} resize-y min-h-[100px]`}
                    />
                </label>

                <label className="block space-y-1.5 text-sm">
                    <span className="text-slate-300 font-medium">
                        رقم الإجابة الصحيحة
                    </span>
                    <input
                        name="quizCorrect"
                        type="number"
                        min={0}
                        defaultValue={0}
                        className={field}
                    />
                    <span className="text-xs text-slate-500">
                        0 = الخيار الأول، 1 = الثاني، 2 = الثالث...
                    </span>
                </label>
            </div>

            <button
                disabled={loading}
                className="w-full bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white font-bold py-3.5 rounded-2xl"
            >
                {loading ? 'جاري رفع الدرس...' : 'حفظ الدرس'}
            </button>
        </form>
    );
}
